<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="200"
    android:viewportHeight="200">
  <!--
       KordX adaptive-icon foreground derived from icon.svg.
       The background color lives in @color/ic_launcher_background so the
       OEM can theme the launcher shape independently.

       Design (200×200 viewport, scaled 70 % around center):
         - Vertical bar at x=60, y=50..150  → Google Blue #4285F4
         - Play triangle (60,100) → (140,50) → (140,150)  → Google Gold #FBBC05
         - 12dp strokes with round caps / joins for a friendly, tactile look.
  -->
  <group
      android:pivotX="100"
      android:pivotY="100"
      android:scaleX="0.7"
      android:scaleY="0.7">
    <!-- Vertical bar -->
    <path
        android:pathData="M60,50L60,150"
        android:strokeColor="#4285F4"
        android:strokeWidth="12"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
    <!-- Play triangle (stroke-only, matching icon.svg) -->
    <path
        android:pathData="M60,100L140,50L140,150Z"
        android:strokeColor="#FBBC05"
        android:strokeWidth="12"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
  </group>
</vector>
