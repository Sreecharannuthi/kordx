<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="200"
    android:viewportHeight="200"
    android:tint="?attr/colorControlNormal">
  <!--
       Monochrome / themed-icon variant of the new KordX logo from icon.svg.
       No hard-coded colors — the system applies the launcher theme color.
       Geometry mirrors ic_launcher_foreground.xml exactly so the adaptive,
       light, and monochrome variants stay visually consistent.
  -->
  <group
      android:pivotX="100"
      android:pivotY="100"
      android:scaleX="0.7"
      android:scaleY="0.7">
    <!-- Vertical bar -->
    <path
        android:pathData="M60,50L60,150"
        android:strokeWidth="12"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
    <!-- Play triangle -->
    <path
        android:pathData="M60,100L140,50L140,150Z"
        android:strokeWidth="12"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
  </group>
</vector>
