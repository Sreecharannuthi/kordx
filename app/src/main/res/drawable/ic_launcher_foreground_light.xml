<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="200"
    android:viewportHeight="200">
  <!--
       Light-background variant of the KordX foreground, used in Settings
       and other light-theme surfaces. The white rounded-rect background
       is drawn inline here so it looks correct when the drawable is used
       as a standalone image rather than an adaptive-icon layer.

       Same geometry as ic_launcher_foreground.xml:
         - White rounded-rect background
         - Blue vertical bar #4285F4
         - Gold play triangle #FBBC05
  -->
  <!-- White rounded-rect background (40dp corner radius) -->
  <path
      android:pathData="M40,0L160,0Q200,0 200,40L200,160Q200,200 160,200L40,200Q0,200 0,160L0,40Q0,0 40,0Z"
      android:fillColor="#FFFFFF" />
  <group
      android:pivotX="100"
      android:pivotY="100"
      android:scaleX="0.7"
      android:scaleY="0.7">
    <!-- Vertical bar -->
    <path
        android:pathData="M60,50L60,150"
        android:strokeColor="#4285F4"
        android:strokeWidth="12"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
    <!-- Play triangle -->
    <path
        android:pathData="M60,100L140,50L140,150Z"
        android:strokeColor="#FBBC05"
        android:strokeWidth="12"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
  </group>
</vector>
