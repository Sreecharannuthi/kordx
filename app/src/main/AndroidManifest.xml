<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".KordXApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:appCategory="audio"
        android:supportsRtl="true"
        android:theme="@style/Theme.KordX"
        tools:targetApi="tiramisu">

        <!-- Android Auto projection metadata: declares the app as a media
             app and provides the themed attribution icon / accent color
             the Auto UI uses for playback controls. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <!-- Attribution icon surfaced by the Android Auto projection UI.
             Must be a single-color tintable vector so the car can theme it.
             Reuses the monochrome launcher foreground (icon.svg geometry). -->
        <meta-data
            android:name="androidx.car.app.TintableAttributionIcon"
            android:resource="@drawable/ic_launcher_monochrome" />

        <!-- Accent color theme for Android Auto playback controls. -->
        <meta-data
            android:name="com.google.android.gms.car.application.theme"
            android:resource="@style/KordXCarTheme" />

        <meta-data
            android:name="com.google.android.gms.car.notification.SmallIcon"
            android:resource="@drawable/ic_launcher_foreground" />
        <activity
            android:name=".MainActivity"
            android:theme="@style/Theme.KordX.SplashScreen"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".ErrorActivity" />

        <provider
            android:name=".services.radio.ArtworkContentProvider"
            android:authorities="com.android.rockages.kordx.artwork"
            android:exported="true"
            android:grantUriPermissions="true"
            tools:ignore="ExportedContentProvider" />

        <!-- The AndroidX Media3 `MediaLibraryService` is the active
             media browser service for Android Auto projection. The
             legacy `MediaBrowserServiceCompat`-based service has been
             deleted. The 26i cutover wires the new service to drive
             playback via the live `KordX.radio` state and bumps
             `minSdk` to 31 (the Media3 `MediaLibraryService.setCustomLayout`
             + `CommandButton` API is API 31+). The
             `BROWSER_SERVICE_EXTRAS_KEY_SEARCH_SUPPORTED` is preserved
             via the `MediaSession.ConnectionResult.AcceptedResultBuilder`
             in `KordXMediaLibraryService.BrowseTreeCallback.onConnect`
             (the Media3 equivalent). -->
        <service
            android:name=".services.radio.KordXMediaLibraryService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <!-- Media3 API (modern) -->
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <!-- Platform API (legacy) - used for Android Auto
                     phone projection discovery -->
                <action android:name="android.media.browse.MediaBrowserService" />
                <!-- Hardware media button events (headset / Bluetooth) on phone -->
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </service>

        <activity
            android:name=".services.radio.MediaSearchActivity"
            android:exported="true"
            tools:ignore="ExportedActivity">
            <intent-filter>
                <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
